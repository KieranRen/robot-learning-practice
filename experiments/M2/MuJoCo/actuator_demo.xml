<mujoco model="actuator_demo">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"/>

    <visual>
        <global realtime="1"/>
        <quality shadowsize="2048"/>
        <headlight
            ambient="0.3 0.3 0.3"
            diffuse="0.7 0.7 0.7"
            specular="0.2 0.2 0.2"/>
    </visual>

    <asset>
        <texture
            name="floor_texture"
            type="2d"
            builtin="checker"
            rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            width="512"
            height="512"/>

        <material
            name="floor_material"
            texture="floor_texture"
            texrepeat="5 5"
            reflectance="0.1"/>
    </asset>

    <worldbody>

        <!-- Floor -->

        <geom
            name="floor"
            type="plane"
            pos="0 0 0"
            size="5 5 0.1"
            material="floor_material"/>

        <!-- Main light -->

        <light
            directional="true"
            pos="0 0 5"
            dir="0 0 -1"
            diffuse="0.8 0.8 0.8"
            specular="0.2 0.2 0.2"/>

        <!-- ===================================================== -->
        <!-- Fixed support                                        -->
        <!-- ===================================================== -->

        <body name="support" pos="0 0 0.1">

            <geom
                name="support_geom"
                type="cylinder"
                size="0.05 0.5"
                mass="100"
                rgba="0.2 0.2 0.2 1"/>

            <!-- ================================================= -->
            <!-- Rotating horizontal arm                          -->
            <!-- ================================================= -->

            <body name="rotary_arm" pos="0 0 0.51">

                <joint
                    name="pivot"
                    type="hinge"
                    pos="0 0 0"
                    axis="0 0 1"
                    damping="0.001"
                    frictionloss="0"/>

                <geom
                    name="horizontal_arm"
                    type="capsule"
                    fromto="0 0 0 0.2 0 0"
                    size="0.01"
                    mass="0.01"
                    rgba="0.2 0.5 0.9 1"/>

                <!-- ============================================= -->
                <!-- Pendulum at end of horizontal arm             -->
                <!-- ============================================= -->

                <body name="pendulum" pos="0.2 0 0">

                    <joint
                        name="ph"
                        type="hinge"
                        pos="0 0 0"
                        axis="1 0 0"
                        damping="0.001"
                        frictionloss="0"/>

                    <geom
                        name="pendulum_rod"
                        type="capsule"
                        fromto="0 0 0 0 0 -0.3"
                        size="0.01"
                        mass="0.005"
                        rgba="0.8 0.3 0.3 1"/>

                    <geom
                        name="pendulum_mass"
                        type="sphere"
                        pos="0 0 -0.3"
                        size="0.03"
                        mass="0.01"
                        rgba="0.9 0.7 0.2 1"/>

                </body>

            </body>

        </body>

    </worldbody>


    <!-- ========================================================= -->
    <!-- Actuators                                                 -->
    <!-- ========================================================= -->

    <actuator>

        <!-- Position control for the horizontal arm -->

        <position
            name="pivot_position"
            joint="pivot"
            kp="2"
            kv="0.1"
            ctrllimited="true"
            ctrlrange="-3.14 3.14"
            forcelimited="true"
            forcerange="-5 5"/>

        <!-- Integrated velocity control for the pendulum -->

        <intvelocity
            name="ph_intvelocity"
            joint="ph"
            kp="100"
            kv="2"
            actlimited="true"
            actrange="-2 2"/>

    </actuator>

</mujoco>